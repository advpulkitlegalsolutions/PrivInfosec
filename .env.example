# ---------------------------------------------------------------------------
# PrivInfosec Consulting website — environment variables
# Copy to .env.local for development. NEVER commit real secrets.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser: never put secrets in them.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
# Canonical origin used for metadata, sitemap and structured data (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.privinfosec.com
# "production" allows indexing; any other value (e.g. "preview") sets robots.txt to disallow all.
NEXT_PUBLIC_DEPLOY_ENV=production
# Public contact email shown in the footer and contact page (leave empty to hide).
NEXT_PUBLIC_CONTACT_EMAIL=
# Show clearly-labelled placeholder content (logos, testimonials, team, case-study template).
# Set to "false" before public launch.
NEXT_PUBLIC_SHOW_CONTENT_PLACEHOLDERS=true
# Expose /design-system in production builds (default: hidden in production).
ENABLE_DESIGN_SYSTEM=false

# --- Booking (Calendly / Cal.com) -----------------------------------------
# calendly | cal | other | none
NEXT_PUBLIC_BOOKING_PROVIDER=none
NEXT_PUBLIC_BOOKING_URL=

# --- Privacy-friendly analytics (loaded only after visitor consent) --------
# plausible | umami | none
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# --- Contact form: bot protection (optional Cloudflare Turnstile) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Contact form: lead delivery ------------------------------------------
# Comma-separated list of providers: console (dev only) | email | webhook | hubspot | zoho | salesforce
LEAD_PROVIDERS=console

# email (Resend HTTP API)
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# webhook (Zapier / Make / n8n / internal). Signed with HMAC-SHA256 when a secret is set.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# hubspot (Forms Submission API v3)
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# zoho / salesforce — adapters stubbed in lib/leads/providers.ts; implement before enabling
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
